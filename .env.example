# ASEL - local secrets. Copy this to .env and fill it in.
# cp .env.example .env
#
# The .env file is NOT committed (see .gitignore).

# A GitHub Personal Access Token with access to the repositories covered by the factory.
# Minimal scope: repo (issues, labels, comments and write access to the repo -
# the agent pushes the plan branch, the factory does not use pull requests).
# Checked by ./asel.sh doctor (GET /user).
GITHUB_TOKEN=

# A Claude Code token from the `claude setup-token` command on the host.
# Eventually a separate machine account, not a personal one.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: the URL of the Woopy inbound webhook for push notifications.
# Empty = notifications disabled (NoopNotifier), regardless of asel.yml.
WOOPY_INBOUND_URL=

# Optional: 1 = the orchestrator logs what it WOULD do, without starting containers.
# Labels and comments on GitHub are still applied (that is what tests the state machine).
DRY_RUN=1

# Optional: log level (debug | info | warn | error). Defaults to info.
LOG_LEVEL=info

# Optional: the hard iteration limit of the green phase in the implementation run.
# Defaults to 3. After the last iteration the run becomes asel:failed and calls a human -
# there is no "keep trying until it works" mode. An invalid value = the default value.
ASEL_GREEN_MAX_ITERATIONS=3

# Optional (only with DRY_RUN=1): which ending of the chain of phases to simulate.
# success (the default) | blocked | red-phase-green | test-guard | green-limit | checks-red
# Used to rehearse the asel:failed and asel:blocked labels without burning tokens.
ASEL_DRY_RUN_IMPLEMENT=success

# Optional: 0 = do not create the ASEL labels in the project repositories on startup.
# Enabled by default; a lack of write permission for labels does not interrupt the work,
# only a warning goes to the log. The colors of existing labels are left alone.
ASEL_BOOTSTRAP_LABELS=1

# 1 = lets the real Sandcastle adapter through (containers, worktrees, real agent
# runs). The @ai-hero/sandcastle dependency has been in package.json since 2026-08-15,
# so the flag is now only a safety switch and no longer a cover for a missing
# library. Empty or any other value = the adapter throws SandcastleNotIntegratedError,
# which means the factory works ONLY in DRY_RUN.
ASEL_ENABLE_SANDCASTLE=1

# Optional: closed = an emergency kill switch for ALL task implement runs,
# overriding the queue and the concurrency limits. The plan pipeline runs
# (wayfinder, adr, prd, slices, tasks) keep going.
ASEL_TASK_GATE=open

# Optional: the UID and GID of the `agent` user in the agent containers.
# Defaults to the user running ./asel.sh (id -u / id -g) - and that is the
# correct value on 99% of machines. The same pair goes to the `docker build` of the
# agent image AND to `docker run --user`, so changing it requires ./asel.sh build.
# The orchestrator in compose runs as root (it needs docker.sock), so it cannot
# work this out itself; no value = a warning in the log and the Sandcastle default,
# which means the agent as root and root-owned files in the worktree on the host.
# Leave these COMMENTED OUT so as not to overwrite the value resolved by asel.sh.
# ASEL_AGENT_UID=
# ASEL_AGENT_GID=

# Optional: the directory for the repository clones and the agent worktrees.
# An absolute path ON THE HOST; defaults to <repo>/repos (set by asel.sh).
# Mounted into the orchestrator container under the same path, because the Docker
# daemon resolves the agent containers' bind mounts on the host side.
# Changing it requires ./asel.sh down && ./asel.sh up (restart does not remount).
ASEL_REPOS_DIR=
